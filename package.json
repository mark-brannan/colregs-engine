{
  "name": "colregs-engine",
  "version": "0.1.0",
  "type": "module",
  "description": "Evaluation engine for structured COLREGS 72 data and national amalgamations",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mark-brannan/colregs-engine.git"
  },
  "homepage": "https://github.com/mark-brannan/colregs-engine#readme",
  "bugs": {
    "url": "https://github.com/mark-brannan/colregs-engine/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "conformance": "tsx research/conformance/run.ts",
    "generate": "tsx scripts/generate-schema-types.ts && tsx scripts/generate-fact-record.ts",
    "generate:check": "npm run generate && git add --intent-to-add -- src/generated && git diff --exit-code -- src/generated",
    "z3": "tsx research/z3/run.ts"
  },
  "dependencies": {
    "colregs": "github:mark-brannan/colregs#a04377336da92043e34e986741f78dc9307dab9c"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "json-schema-to-typescript": "16.0.0",
    "prettier": "3.6.2",
    "tsx": "4.23.13",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7",
    "z3-solver": "^4.15.3"
  }
}
